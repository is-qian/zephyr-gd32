/*
 * MicroDuck power board MCU (GD32C231F8P6TR)
 */

/dts-v1/;

#include <gd/gd32c2x1/gd32c231f8.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include "gd32c231f8_dk-pinctrl.dtsi"

/ {
	model = "GD32C231F8 Dynamixel to IMU board";
	compatible = "gd,gd32c231f8-dk";

	chosen {
		zephyr,flash = &flash0;
		zephyr,sram = &sram0;
	};

	zephyr_user: zephyr-user {
		compatible = "zephyr,user";
		/* PA0 = ADC_CTL: powers the ADC sense divider, driven high at boot */
		adc-ctl-gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
		/* PA1 = ADC0_IN1: Vbat divider sample (Vbat = Vadc x 2.8) */
		io-channels = <&adc0 1>;
		/* I2C0 bus recovery bit-bang (SCL, SDA) */
		rec-gpios = <&gpiob 6 GPIO_OPEN_DRAIN>, <&gpiob 7 GPIO_OPEN_DRAIN>;
	};
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&usart0 {
	status = "okay";
	current-speed = <1000000>;
	pinctrl-0 = <&usart0_default>;
	pinctrl-names = "default";
};

&i2c0 {
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	/* LSM6DSV16XTR at I2C 0x6A; sensor driver disabled, the app accesses registers directly */
	lsm6dsv16x: imu@6a {
		compatible = "st,lsm6dsv16x";
		reg = <0x6a>;
		status = "disabled";
	};
};

&adc0 {
	pinctrl-0 = <&adc0_default>;
	pinctrl-names = "default";
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		/* longest acquisition time (160.5 cycles) for the 18K/10K divider source impedance */
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 161)>;
		zephyr,resolution = <12>;
		zephyr,vref-mv = <3300>;
	};
};
